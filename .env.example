# Copy to .env. Never commit .env. Use a secret manager in production.
# Note: an optional setting that is present but EMPTY (KEY=) fails validation in backend-node
# (src/config/env.js). Leave unused optional keys commented out, as below.
POSTGRES_USER=avzar
POSTGRES_PASSWORD=change_me_locally
WEB_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
# Optional comma-separated proxy IPs/CIDRs; leave blank unless traffic can only reach Node through these proxies.
# Render: set TRUSTED_PROXY_CIDRS=uniquelocal on the API service. Without it every visitor shares one rate-limit bucket
# and express-rate-limit logs ERR_ERL_UNEXPECTED_X_FORWARDED_FOR. The web service forwards the client address only when
# TRUST_PROXY_HEADERS=true is set on it (web/src/app/backend/[...path]/route.ts).
TRUSTED_PROXY_CIDRS=

# Startup database work. When unset: on in development, off in every other NODE_ENV.
# Migrations take an advisory lock, so several instances starting together are safe. Plans are seeded after migrations.
# A deployed environment (staging, production) that should migrate itself must set both to true.
# DATABASE_MIGRATE_ON_STARTUP=true
# BILLING_SEED_PLANS_ON_STARTUP=true
DATABASE_URL=postgresql://avzar:change_me_locally@localhost:5432/avzar_node_dev
DATABASE_POOL_MAX=10
# Optional Expo server access token for push delivery. Leave commented out until configured.
# EXPO_ACCESS_TOKEN=your-expo-access-token

# Public site hosting.
BASE_DOMAIN=localhost
API_PUBLIC_URL=http://localhost:8081
TURNSTILE_SITE_KEY=
# STOREFRONT_BASE_DOMAIN=avzar.app
# STOREFRONT_CAPTCHA_SECRET_KEY=

# Mobile bearer auth. Use a 32+ character key in real deployments.
JWT_SIGNING_KEY=
JWT_ISSUER=avzar-api
JWT_AUDIENCE=avzar-mobile
ACCESS_TOKEN_MINUTES=10
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
MAX_SESSIONS_PER_USER=10
REQUIRE_VERIFIED_EMAIL=false
LOG_LEVEL=info

# Email. Use a real provider and credentials outside development; log mode does not deliver.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Avzar
EMAIL_DISPATCHER_ENABLED=true
EMAIL_MAX_ATTEMPTS=6
EMAIL_BATCH_SIZE=20
EMAIL_POLL_SECONDS=5
EMAIL_LEASE_MINUTES=5
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_WEBHOOK_SECRET=

# Optional provider integrations. Uncomment and fill in to enable.
# AI_OPENAI_API_KEY=
AI_OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_OPENAI_IMAGE_MODEL=gpt-image-1
AI_DAILY_LIMIT_PER_BUSINESS=50
# BILLING_PAYSTACK_SECRET_KEY=
# BILLING_PAYSTACK_CALLBACK_URL=https://your-web-host.example/settings/billing
STORAGE_PROVIDER=local

# Keep production secrets out of source control.
# Set provider keys and long-lived tokens in your host secrets manager, not here.

# Subscription lifecycle (defaults shown). Trials last BILLING_TRIAL_DAYS; an unpaid renewal keeps paid access for BILLING_GRACE_DAYS,
# then the plan drops to Free limits. No data is ever deleted or locked. The sweep runs every SUBSCRIPTION_LIFECYCLE_INTERVAL_MINUTES.
# BILLING_TRIAL_DAYS=14
# BILLING_GRACE_DAYS=7
# SUBSCRIPTION_LIFECYCLE_ENABLED=true
# SUBSCRIPTION_LIFECYCLE_INTERVAL_MINUTES=60
