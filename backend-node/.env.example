# Node API service. Do not add production credentials to this file.
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
# Optional comma-separated proxy IPs/CIDRs; leave blank unless traffic can only reach Node through these proxies.
# Render: set TRUSTED_PROXY_CIDRS=uniquelocal. Without it every visitor shares one rate-limit bucket.
TRUSTED_PROXY_CIDRS=
# Startup database work. When unset: on in development, off in every other NODE_ENV.
# DATABASE_MIGRATE_ON_STARTUP=true
# BILLING_SEED_PLANS_ON_STARTUP=true
# PostgreSQL connection for the Node API.
DATABASE_URL=postgresql://avzar:change-me@localhost:5432/avzar_node_dev
DATABASE_POOL_MAX=10
# Optional Expo server access token. Without it, push delivery stays unavailable and no delivery rows are created.
# EXPO_ACCESS_TOKEN=your-expo-access-token
# Browser and mobile authentication remain disabled until a 32+ character key is configured.
JWT_SIGNING_KEY=
# Optional separate HMAC key for CSRF tokens; falls back to JWT_SIGNING_KEY. Production requires one stable 32+ character key across replicas.
# CSRF_SIGNING_KEY=
JWT_ISSUER=avzar-api
JWT_AUDIENCE=avzar-mobile
ACCESS_TOKEN_MINUTES=10
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
MAX_SESSIONS_PER_USER=10
REQUIRE_VERIFIED_EMAIL=false
LOG_LEVEL=info
# Account links (email confirmation / password reset). Falls back to JWT_SIGNING_KEY when unset; needs >= 32 characters.
# ACCOUNT_TOKEN_KEY=
WEB_BASE_URL=http://localhost:3000
# Public HTTPS base URL used for ownership confirmation links.
# PUBLIC_BASE_URL=https://app.example.com
ALLOW_INSECURE_PUBLIC_BASE_URL=false
INVITATION_DAYS=7
# Comma-separated emails permitted to manage global plans.
PLATFORM_ADMIN_EMAILS=
PRODUCT_NAME=Avzar
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
EMAIL_THROTTLE_SECONDS=120
# Email dispatcher configuration. Log mode does not deliver messages.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Avzar
EMAIL_DISPATCHER_ENABLED=true
EMAIL_MAX_ATTEMPTS=6
EMAIL_BATCH_SIZE=20
EMAIL_POLL_SECONDS=5
EMAIL_LEASE_MINUTES=5
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_WEBHOOK_SECRET=
# File storage defaults to a local directory. S3-compatible storage requires the secret key settings below.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/media
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_KEY_PREFIX=
MEDIA_MAX_UPLOAD_BYTES=12582912
MEDIA_MAX_PIXELS=50000000
DOCUMENT_MAX_UPLOAD_BYTES=15728640
STORAGE_QUOTA_BYTES_PER_GB=1073741824
# Antivirus is optional by default. Required clamav scans need a reachable clamd service.
ANTIVIRUS_PROVIDER=none
ANTIVIRUS_HOST=localhost
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=30
ANTIVIRUS_REQUIRED=false

# BILLING_PAYSTACK_SECRET_KEY=
# BILLING_PAYSTACK_CALLBACK_URL=
# AI_OPENAI_API_KEY=
AI_OPENAI_IMAGE_MODEL=gpt-image-1
AI_OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT_PER_BUSINESS=50

# Optional outbound customer messaging (disabled unless the corresponding credentials are set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Exact URL Twilio calls for inbound SMS (STOP replies); leave empty to use PUBLIC_BASE_URL + /api/messaging/twilio/inbound
TWILIO_INBOUND_WEBHOOK_URL=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TEMPLATE_LANGUAGE=en
META_GRAPH_API_VERSION=v23.0
CUSTOMER_MESSAGE_WORKER_ENABLED=true
CUSTOMER_MESSAGE_WORKER_POLL_SECONDS=15
