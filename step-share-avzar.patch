diff --git a/web/src/components/app/ShareAvzarButton.tsx b/web/src/components/app/ShareAvzarButton.tsx
new file mode 100644
index 0000000..9a5ea9f
--- /dev/null
+++ b/web/src/components/app/ShareAvzarButton.tsx
@@ -0,0 +1,33 @@
+'use client';
+
+import { toast } from '@/lib/toast';
+
+const SHARE_TEXT = 'Avzar helps tailors and fashion makers run their workshop: customers, measurements, orders and payments in one place.';
+
+/**
+ * Shares the public Avzar site. Uses the phone's share sheet when there is one; otherwise copies the link;
+ * if copying is blocked too, shows the link in a message so it can be copied by hand.
+ */
+export function ShareAvzarButton({ className }: { className?: string }) {
+  async function share() {
+    const url = window.location.origin;
+    if (typeof navigator.share === 'function') {
+      try {
+        await navigator.share({ title: 'Avzar', text: SHARE_TEXT, url });
+        return;
+      } catch (e) {
+        // Closing the share sheet is a choice, not a failure.
+        if (e instanceof DOMException && e.name === 'AbortError') return;
+        // Any other failure falls through to copying the link.
+      }
+    }
+    try {
+      await navigator.clipboard.writeText(url);
+      toast.success('Link copied. Paste it anywhere to share Avzar.');
+    } catch {
+      toast.error(`Could not copy automatically. The link is ${url}`);
+    }
+  }
+
+  return <button type="button" className={className} onClick={() => void share()}>Share Avzar</button>;
+}
diff --git a/web/test/components/ShareAvzarButton.test.tsx b/web/test/components/ShareAvzarButton.test.tsx
new file mode 100644
index 0000000..a0e3053
--- /dev/null
+++ b/web/test/components/ShareAvzarButton.test.tsx
@@ -0,0 +1,58 @@
+// @vitest-environment jsdom
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('@/lib/toast', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+
+import { toast } from '@/lib/toast';
+import { ShareAvzarButton } from '@/components/app/ShareAvzarButton';
+
+const nav = navigator as unknown as Record<string, unknown>;
+
+function setNavigator(share: unknown, writeText: unknown) {
+  Object.defineProperty(nav, 'share', { value: share, configurable: true });
+  Object.defineProperty(nav, 'clipboard', { value: writeText ? { writeText } : undefined, configurable: true });
+}
+
+describe('ShareAvzarButton', () => {
+  beforeEach(() => { vi.mocked(toast.success).mockClear(); vi.mocked(toast.error).mockClear(); });
+  afterEach(() => setNavigator(undefined, undefined));
+
+  it('opens the share sheet with the site address when the device has one', async () => {
+    const share = vi.fn().mockResolvedValue(undefined);
+    setNavigator(share, undefined);
+    render(<ShareAvzarButton />);
+    fireEvent.click(screen.getByRole('button', { name: 'Share Avzar' }));
+    await waitFor(() => expect(share).toHaveBeenCalledWith(expect.objectContaining({ url: window.location.origin })));
+    expect(toast.error).not.toHaveBeenCalled();
+  });
+
+  it('says nothing when the share sheet is closed without sharing', async () => {
+    const share = vi.fn().mockRejectedValue(new DOMException('closed', 'AbortError'));
+    const writeText = vi.fn();
+    setNavigator(share, writeText);
+    render(<ShareAvzarButton />);
+    fireEvent.click(screen.getByRole('button', { name: 'Share Avzar' }));
+    await waitFor(() => expect(share).toHaveBeenCalled());
+    expect(writeText).not.toHaveBeenCalled();
+    expect(toast.success).not.toHaveBeenCalled();
+    expect(toast.error).not.toHaveBeenCalled();
+  });
+
+  it('copies the link when there is no share sheet', async () => {
+    const writeText = vi.fn().mockResolvedValue(undefined);
+    setNavigator(undefined, writeText);
+    render(<ShareAvzarButton />);
+    fireEvent.click(screen.getByRole('button', { name: 'Share Avzar' }));
+    await waitFor(() => expect(writeText).toHaveBeenCalledWith(window.location.origin));
+    expect(toast.success).toHaveBeenCalled();
+  });
+
+  it('shows the link when copying is blocked too', async () => {
+    const writeText = vi.fn().mockRejectedValue(new Error('denied'));
+    setNavigator(undefined, writeText);
+    render(<ShareAvzarButton />);
+    fireEvent.click(screen.getByRole('button', { name: 'Share Avzar' }));
+    await waitFor(() => expect(toast.error).toHaveBeenCalledWith(expect.stringContaining(window.location.origin)));
+  });
+});
